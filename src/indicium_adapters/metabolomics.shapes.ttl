@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix asb:   <https://asb.holobiomics.org/ns/asb#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/indicium/shapes/metabolomics/OntologyTermCurieShape>
    a sh:NodeShape ;
    rdfs:comment "Ontology term CURIEs on metabolomics claims must use canonical CURIE format PREFIX:id." ;
    sh:targetClass asb:Claim ;
    sh:property [
        sh:path asb:subject_ontology_term ;
        sh:datatype xsd:string ;
        sh:pattern "^\\w+:[A-Za-z0-9_]+$" ;
        sh:severity sh:Warning ;
        sh:message "subject_ontology_term must be a valid CURIE (e.g. CHEBI:17234)" ;
    ] ;
    sh:property [
        sh:path asb:object_ontology_term ;
        sh:datatype xsd:string ;
        sh:pattern "^\\w+:[A-Za-z0-9_]+$" ;
        sh:severity sh:Warning ;
        sh:message "object_ontology_term must be a valid CURIE (e.g. CHEBI:15361)" ;
    ] .
